# ---------- Browser-safe (exposed to the client) ----------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key

# ---------- Server-only (NEVER prefix with VITE_, NEVER commit real values) ----------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key

# Optional: AI features (meeting briefs, summaries, smart search)
GROQ_API_KEY=your_groq_api_key

# Optional: push reminders. Any long random string, e.g. `openssl rand -hex 32`.
# Must match the secret you put in supabase/optional/push-reminders-cron.sql
DISPATCH_REMINDERS_SECRET=your_long_random_secret
